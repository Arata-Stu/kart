    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /visual_slam/vis/landmarks_cloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
