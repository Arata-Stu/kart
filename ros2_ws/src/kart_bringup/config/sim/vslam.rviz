    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Value: true
  - Alpha: 1
