<?xml version="1.0"?>
<package format="3">
  <name>kart_parking</name><version>0.1.0</version>
  <description>Directed course-guided forward parking planner and stop verification.</description>
  <maintainer email="carbuncle01@users.noreply.github.com">carbuncle01</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>kart_hdmap</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rcl_interfaces</exec_depend>
