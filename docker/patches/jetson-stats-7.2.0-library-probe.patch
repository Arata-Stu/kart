+def load_library(name):
+    library_path = find_library(name)
+    if not library_path:
+        return None
+    try:
+        return CDLL(library_path)
+    except OSError:
+        # Fall back to package metadata when an optional transitive dependency
+        # is not present in the container.
+        return None
+
