# syntax=docker/dockerfile:1
# Dockerfile for building OpenEB with the CenturyArks SilkyEvCam plugin.
#
# Before building, manually obtain and extract the official plugin source from
# CenturyArks, then place hal/, hal_psee_plugins/, and licensing/ under:
#   docker/silky_evcam_plugin_source/
ARG BASE_IMAGE=ubuntu:24.04
ARG PLATFORM=amd64
ARG UV_VERSION=0.12.0
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${BASE_IMAGE} AS openeb

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/bin:${PATH}

ARG OPENEB_GIT_URL=https://github.com/prophesee-ai/openeb.git
ARG OPENEB_VERSION=5.2.0
ARG OPENEB_BUILD_JOBS=2

WORKDIR /opt
USER root
ARG PLATFORM
RUN test "${PLATFORM}" = "$(dpkg --print-architecture)" \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' \
        > /etc/apt/apt.conf.d/keep-cache
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libboost-filesystem-dev \
        libboost-program-options-dev \
        libboost-thread-dev \
        libboost-timer-dev \
        libeigen3-dev \
        libglew-dev \
        libglfw3-dev \
        libhdf5-dev \
        libopencv-dev \
        libprotobuf-dev \
        libssl-dev \
        libusb-1.0-0-dev \
        pkg-config \
        pybind11-dev \
        python3-dev \
        python3-h5py \
        python3-numpy \
        python3-pybind11 \
        python3-pip \
        python3-venv \
        ros-lyrical-event-camera-codecs \
        ros-lyrical-event-camera-msgs \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY silky_evcam_plugin_source/ /tmp/silky_evcam_plugin_source/

RUN set -eux; \
    git clone --recursive --depth 1 --branch "${OPENEB_VERSION}" "${OPENEB_GIT_URL}" /opt/openeb; \
    test -d /tmp/silky_evcam_plugin_source/hal; \
    test -d /tmp/silky_evcam_plugin_source/hal_psee_plugins; \
    test -d /tmp/silky_evcam_plugin_source/licensing; \
    cp -av \
        /tmp/silky_evcam_plugin_source/hal \
        /tmp/silky_evcam_plugin_source/hal_psee_plugins \
        /tmp/silky_evcam_plugin_source/licensing \
        /opt/openeb/; \
    cmake -S /opt/openeb -B /opt/openeb/build \
        -DBUILD_TESTING=OFF \
        -DCOMPILE_PYTHON3_BINDINGS=OFF \
        -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /opt/openeb/build --config Release -- -j"${OPENEB_BUILD_JOBS}"; \
    cmake --install /opt/openeb/build; \
    ldconfig; \
    rm -rf /opt/openeb /tmp/silky_evcam_plugin_source

ENV CMAKE_PREFIX_PATH=/usr/local:${CMAKE_PREFIX_PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}
WORKDIR /workspaces/ros2_ws
